<?xml version="1.0" encoding="UTF-8"?><ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName>GV_Stock_Invariants</fullName><active>true</active><errorConditionFormula>OR(Stock_Quantity__c &lt; 0,Reserved_Quantity__c &lt; 0,Reserved_Quantity__c &gt; Stock_Quantity__c,MOD(Stock_Quantity__c,1) &lt;&gt; 0,MOD(Reserved_Quantity__c,1) &lt;&gt; 0)</errorConditionFormula><errorMessage>Stock and reserved units must be whole, nonnegative, with reserved units no greater than stock.</errorMessage></ValidationRule>