<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Grand_Total__c</fullName>
    <description>Final payable amount.</description>
    <formula>BLANKVALUE(Subtotal__c, 0)
- BLANKVALUE(Discount_Amount__c, 0)
+ BLANKVALUE(Tax_Amount__c, 0)
+ BLANKVALUE(Shipping_Charges__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Calculated automatically.</inlineHelpText>
    <label>Grand Total</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
